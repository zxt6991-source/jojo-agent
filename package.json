{
  "name": "ts-desktop-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @desktop-agent/desktop start",
    "dev:server": "pnpm --filter @desktop-agent/cli jojo serve",
    "jojo": "pnpm --filter @desktop-agent/cli jojo",
    "build": "pnpm --filter @desktop-agent/desktop make",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime-smoke": "vitest run packages/runtime-composition/test/headless-runtime.test.ts",
    "test:e2e:electron": "pnpm --filter @desktop-agent/desktop test:e2e",
    "test:watch": "vitest",
    "test:architecture": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "docs:generate": "node --experimental-strip-types scripts/generate-docs.mjs",
    "docs:check": "node --experimental-strip-types scripts/generate-docs.mjs --check",
    "test:conformance": "vitest run packages/runtime-composition/test/cross-host-conformance.test.ts packages/server-protocol/test/operation-conformance.test.ts",
    "test:release": "node --test scripts/release/release.test.mjs",
    "release:verify": "node scripts/release/artifacts.mjs verify",
    "release:snapshot": "node scripts/release/snapshot.mjs",
    "test:bindings": "node --test scripts/check-application-bindings.test.mjs && node scripts/check-application-bindings.mjs",
    "eval:offline": "node scripts/run-agent-task-evals.mjs",
    "test:evals": "node --test scripts/evaluate-agent-tasks.test.mjs scripts/run-agent-task-evals.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@electron/node-gyp": "10.2.0-electron.1"
    }
  }
}
