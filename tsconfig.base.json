{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@desktop-agent/contracts": ["packages/contracts/src/index.ts"],
      "@desktop-agent/agent-core": ["packages/agent-core/src/index.ts"],
      "@desktop-agent/providers": ["packages/providers/src/index.ts"],
      "@desktop-agent/tools-node": ["packages/tools-node/src/index.ts"],
      "@desktop-agent/storage": ["packages/storage/src/index.ts"]
      ,"@desktop-agent/extensions": ["packages/extensions/src/index.ts"]
      ,"@desktop-agent/orchestration": ["packages/orchestration/src/index.ts"]
    }
  }
}
